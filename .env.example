# Copy to .env (repo root) and fill in. .env is git-ignored. Never put real keys in this file.

# --- Server ---
# 5000 is used by macOS AirPlay Receiver ("AirTunes") on recent macOS, so we default to 5001.
PORT=5001
CLIENT_URL=http://localhost:5173

# --- OpenAI (required) ---
OPENAI_API_KEY=
# Defaults shown; any OpenAI embedding / chat-completions model works.
# Changing the embedding model creates a NEW Chroma collection; re-ingest documents afterwards.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=4
EMBEDDING_BATCH_SIZE=64

# --- ChromaDB (docker compose up -d) ---
CHROMA_URL=http://localhost:8000
# Base name; the embedding model slug is appended so incompatible vectors never share a collection.
CHROMA_COLLECTION_NAME=gpo_annual_report

# --- Ingestion / chunking ---
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# Average extracted characters per page below which a PDF is treated as scanned (needs OCR).
MIN_EXTRACTED_CHARS_PER_PAGE=100

# --- Retrieval / generation ---
RETRIEVAL_TOP_K=5
# Chunks with cosine similarity below this are dropped. Tune using the Retrieval inspector.
RETRIEVAL_MIN_SIMILARITY=0.2
MAX_CONTEXT_TOKENS=6000
MAX_QUESTION_CHARS=1000

# --- Sample report (GPO Annual Report 2018, published on gpo.gov) ---
SAMPLE_PDF_URL=https://www.gpo.gov/docs/default-source/news-content-pdf-files/2018_annualreport.pdf
SAMPLE_PDF_PATH=data/samples/gpo-annual-report-2018.pdf
SAMPLE_DOCUMENT_NAME=GPO Annual Report 2018
STORAGE_DIR=server/storage
